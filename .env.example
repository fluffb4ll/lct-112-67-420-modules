# ==========================================
# Настройки Docker Registry и тегов
# ==========================================
# Адрес вашего Docker Registry (например: ghcr.io/username, mydockerhubuser, cr.yandex/crpXXXXX)
# Если оставить пустым, будут использованы локальные имена образов: dds-ai, dds-backend, dds-frontend
DOCKER_REGISTRY=ghcr.io/fluffb4ll

# Тег образов (по умолчанию: latest)
IMAGE_TAG=latest

# ==========================================
# Порты сервисов на хосте
# ==========================================
FRONTEND_PORT=80
BACKEND_PORT=8080
AI_PORT=8090
# ИИ-контур нужен только бэкенду и nginx по сети compose: наружу не публикуем (0.0.0.0 — открыть всем)
AI_BIND=127.0.0.1
POSTGRES_PORT=5432

# ==========================================
# База данных PostgreSQL
# ==========================================
POSTGRES_USER=dds_user
POSTGRES_PASSWORD=dds_password_secret

# ==========================================
# Настройки бэкенда (Spring Boot)
# ==========================================
PEPPER=supersecretpepper123!
SADMIN_USERNAME=admin
SADMIN_PASSWORD=admin123

# ==========================================
# Настройки ИИ-контура
# ==========================================
DDS_LLM_MODEL_PATH=/models/llm/model.gguf
# Разовая докачка весов (LLM, faster-whisper, голоса Piper) при первом запуске: 1 — да, 0 — нет
DDS_FETCH_MODELS=1
# Своя LLM в формате GGUF вместо Qwen2.5-1.5B (например, Qwen2.5-3B для более точной оценки)
DDS_LLM_MODEL_URL=
